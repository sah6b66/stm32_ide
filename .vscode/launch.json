{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug (pyOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/firmware.elf",
            "servertype": "pyocd",
            "serverpath": "${workspaceFolder}/tools/pyocd-venv/Scripts/pyocd.exe",
            "gdbPath": "${workspaceFolder}/tools/arm-gcc/bin/arm-none-eabi-gdb.exe",
            "device": "STM32F103C8",
            "runToEntryPoint": "main"
            // 可选：配置 svdFile 指向芯片 SVD 文件以查看外设寄存器
        }
    ]
}
